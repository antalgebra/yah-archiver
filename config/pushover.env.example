# Copy to /etc/yah-arch/pushover.env on the server.
# Keep the real file out of Git and readable only by root and yaharch.
PUSHOVER_APP_TOKEN=replace-with-your-application-api-token
PUSHOVER_USER_KEY=replace-with-your-user-key
# Optional: send only to one registered Pushover device.
# PUSHOVER_DEVICE=your-device-name
